# Copy to .env (or set in your host's environment). Every value is optional in development.

# --- Server ---------------------------------------------------------------
PORT=3000
# Browser origins allowed to call the API and sign in. The first one is used in links.
APP_ORIGIN=http://localhost:5173,http://localhost:3000
# Required in production: at least 32 random characters (signs private media links).
APP_SECRET=
# Only behind a reverse proxy you control (load balancer, Fly, Railway, etc.).
TRUST_PROXY=false

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use embedded PGlite under server/data/.
DATABASE_URL=
# PGLITE_DIR=server/data/pglite

# --- Blockchain -----------------------------------------------------------
# "mock" (default outside production) uses simulated balances you set in Settings.
# "rpc" (default and required in production) reads real ERC-20/721/1155 balances via the RPC URLs below.
# CHAIN_MODE=rpc
SUPPORTED_CHAIN_IDS=8453
# RPC_URL_8453=https://mainnet.base.org
BALANCE_CACHE_TTL_SECONDS=300
BALANCE_STALE_GRACE_SECONDS=3600
CHAIN_TIMEOUT_MS=5000

# --- Platform -------------------------------------------------------------
# Wallets that become platform administrators when they sign in (comma separated).
PLATFORM_ADMIN_WALLETS=
# "open" lets any signed-in user create a community; "admin" restricts it to platform admins.
COMMUNITY_CREATION=open
# Enables dev wallets, simulated balances and the outage switch. Never enable in production.
DEV_MODE=
# Private uploads (lesson videos, attachments, submissions). Use a persistent volume.
UPLOAD_DIR=server/data/uploads
MAX_UPLOAD_MB=200
SESSION_DAYS=30
# Run background jobs (campaign expiry, cleanup) on exactly one instance.
JOBS_ENABLED=true
